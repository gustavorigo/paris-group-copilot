# Exemplo de configuração local — copie para .env.local
# e defina no ambiente de deploy em produção.
# Este arquivo é versionado: NUNCA coloque valores reais aqui.

# URL pública do backend FastAPI. Obrigatória em produção.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Conexão com o PostgreSQL. Obrigatória em produção. Contém credencial.
DATABASE_URL=

# Conexão com o Redis. Opcional enquanto não há cache.
REDIS_URL=
